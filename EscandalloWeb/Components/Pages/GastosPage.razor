@page "/gastos"
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SesionUsuarioService Sesion

<PageTitle>Gastos Generales - Escandallo</PageTitle>

@if (_centro is null || _usuario is null)
{
    <div class="alert alert-warning">Selecciona un centro activo o inicia sesión.</div>
}
else
{
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:0.75rem;">
        <h1 style="margin:0; font-size:1.5rem;">Hoja Gastos Generales — @_centro.Nombre</h1>
        <a href="manual" class="btn btn-outline">📖 Ver Manual de Ayuda</a>
    </div>

    @if (!_usuario.SuscripcionActiva)
    {
        <div class="alert alert-warning">Suscripción inactiva. <a href="suscripcion">Activa un plan</a> para editar gastos generales.</div>
    }
    else
    {
        <div class="card">
            <h3 style="margin-top:0; font-size:1.05rem;">Añadir Gasto General</h3>
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:flex-end;">
                <div class="form-group" style="margin:0;">
                    <label>
                        Nombre
                        <span class="help-tip" tabindex="0" data-tip="Concepto de gasto fijo u operativo mensual del centro (ej. Local, Consumos, Consumibles).">?</span>
                    </label>
                    <input @bind="_nuevoNombre" placeholder="Ej. Alquiler, Seguros..." title="Nombre del gasto general mensual" />
                </div>
                <div class="form-group" style="margin:0;">
                    <label>
                        Cantidad
                        <span class="help-tip" tabindex="0" data-tip="Capacidad productiva mensual en la unidad indicada. En la Excel original: 8h x 60min x 22 días = 10.560 minutos/mes.">?</span>
                    </label>
                    <div class="qty-field">
                        <input type="number" step="0.01" @bind="_nuevaCantidad" title="Cantidad mensual (por defecto 10560 minutos/mes)" />
                        <span class="unit-badge">@_nuevaUnidad</span>
                    </div>
                </div>
                <div class="form-group" style="margin:0;">
                    <label>
                        Coste para empresa (€)
                        <span class="help-tip" tabindex="0" data-tip="Importe total mensual en euros que supone este gasto para la clínica.">?</span>
                    </label>
                    <input type="number" step="0.01" @bind="_nuevoCoste" title="Coste mensual en euros" />
                </div>
                <button class="btn btn-primary" @onclick="AgregarGastoAsync">+ Añadir Gasto</button>
            </div>
        </div>
    }

    <div class="card">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th class="num">
                            Cantidad
                            <span class="help-tip" tabindex="0" data-tip="Cantidad total mensual expresada en su unidad de medida (10.560 minutos/mes = 8h x 60min x 22 días).">?</span>
                        </th>
                        <th class="num">
                            Coste para empresa (€)
                            <span class="help-tip" tabindex="0" data-tip="Coste mensual total del concepto en euros.">?</span>
                        </th>
                        <th class="num">
                            Precio Unitario
                            <span class="help-tip" tabindex="0" data-tip="Fórmula: Coste para empresa / Cantidad.">?</span>
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _centro.GastosGenerales)
                    {
                        <tr>
                            <th>
                                <input value="@g.Nombre" disabled="@(!_usuario.SuscripcionActiva)"
                                       title="Editar nombre del gasto"
                                       @onchange="(e) => ActualizarGastoAsync(g.Id, nombre: e.Value?.ToString())" />
                            </th>
                            <td class="num">
                                <div class="qty-field">
                                    <input type="number" step="0.01" value="@g.Cantidad.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           disabled="@(!_usuario.SuscripcionActiva)"
                                           title="Cantidad total (@g.UnidadMedida)"
                                           @onchange="(e) => ActualizarGastoAsync(g.Id, cantidadStr: e.Value?.ToString())" />
                                    <span class="unit-badge">@g.UnidadMedida</span>
                                </div>
                            </td>
                            <td class="num">
                                <input type="number" step="0.01" value="@g.CosteEmpresa.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       disabled="@(!_usuario.SuscripcionActiva)"
                                       title="Coste mensual en euros"
                                       @onchange="(e) => ActualizarGastoAsync(g.Id, costeStr: e.Value?.ToString())" />
                            </td>
                            <td class="num formula-cell" title="Fórmula: Coste para empresa / Cantidad">
                                @g.PrecioUnitario.ToString("N5") €/@g.UnidadMedida
                            </td>
                            <td>
                                <button class="btn btn-danger" disabled="@(!_usuario.SuscripcionActiva)"
                                        @onclick="() => EliminarGastoAsync(g.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                    <tr class="formula-cell">
                        <th>
                            Total (SUBTOTAL)
                            <span class="help-tip" tabindex="0" data-tip="Suma de todos los precios unitarios de Gastos Generales. Se multiplica por los minutos de cada servicio.">?</span>
                        </th>
                        <td colspan="2"></td>
                        <td class="num">@_centro.TotalPrecioUnitarioGastosGenerales.ToString("N5") €/minutos/mes</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private Usuario? _usuario;
    private CentroEstetica? _centro;

    private string _nuevoNombre = string.Empty;
    private decimal _nuevaCantidad = 10560m;
    private string _nuevaUnidad = "minutos/mes";
    private decimal _nuevoCoste;

    protected override async Task OnInitializedAsync()
    {
        Sesion.OnEstadoCambiado += RecargarAsync;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        await Sesion.AsegurarSesionInicialAsync();
        _usuario = await Sesion.ObtenerUsuarioActualAsync();
        if (Sesion.CentroActualId.HasValue)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _centro = await db.Centros
                .Include(c => c.GastosGenerales)
                .FirstOrDefaultAsync(c => c.Id == Sesion.CentroActualId.Value);
        }
    }

    private async Task AgregarGastoAsync()
    {
        if (_centro is null || string.IsNullOrWhiteSpace(_nuevoNombre)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.GastosGenerales.Add(new GastoGeneral
        {
            CentroEsteticaId = _centro.Id,
            Nombre = _nuevoNombre.Trim(),
            Cantidad = _nuevaCantidad > 0 ? _nuevaCantidad : 10560m,
            UnidadMedida = string.IsNullOrWhiteSpace(_nuevaUnidad) ? "minutos/mes" : _nuevaUnidad.Trim(),
            CosteEmpresa = _nuevoCoste
        });
        await db.SaveChangesAsync();
        _nuevoNombre = string.Empty;
        _nuevoCoste = 0m;
        await CargarAsync();
    }

    private async Task ActualizarGastoAsync(int id, string? nombre = null, string? cantidadStr = null, string? costeStr = null)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var g = await db.GastosGenerales.FindAsync(id);
        if (g is null) return;

        if (nombre is not null && !string.IsNullOrWhiteSpace(nombre))
            g.Nombre = nombre.Trim();
        if (cantidadStr is not null && decimal.TryParse(cantidadStr.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var cant) && cant > 0)
            g.Cantidad = cant;
        if (costeStr is not null && decimal.TryParse(costeStr.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var coste))
            g.CosteEmpresa = coste;

        await db.SaveChangesAsync();
        await CargarAsync();
    }

    private async Task EliminarGastoAsync(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var g = await db.GastosGenerales.FindAsync(id);
        if (g is not null)
        {
            db.GastosGenerales.Remove(g);
            await db.SaveChangesAsync();
            await CargarAsync();
        }
    }

    private async void RecargarAsync()
    {
        await CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Sesion.OnEstadoCambiado -= RecargarAsync;
}
